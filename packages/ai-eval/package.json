{
  "name": "@showzy/ai-eval",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Dev-only staff-assistant eval harness. Leaf: apps and @showzy/ai must not depend on this package. Live eval is hand-run and is not on the PR path.",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:unit": "vitest run",
    "eval": "node ./eval-cli.mjs"
  },
  "dependencies": {
    "@showzy/ai": "workspace:*",
    "@showzy/catalog": "workspace:*",
    "@showzy/companies": "workspace:*",
    "@showzy/config": "workspace:*",
    "@showzy/core": "workspace:*",
    "@showzy/customers": "workspace:*",
    "@showzy/orders": "workspace:*",
    "@showzy/pricing": "workspace:*",
    "ai": "7.0.87",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@showzy/tooling": "workspace:*",
    "@types/node": "^22.20.1",
    "eslint": "^10.8.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
