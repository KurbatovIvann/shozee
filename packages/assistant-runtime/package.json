{
  "name": "@showzy/assistant-runtime",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Server half of the staff assistant (ADR-0039): runtime composition, tools, resolution, confirmation, history window, kit stores, budget guard, and the assistant queue contract. Imported by apps/api and apps/worker; no HTTP.",
