    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:unit": "vitest run --project unit"
  },
  "dependencies": {
    "@showzy/ai": "workspace:*",
    "@showzy/assistant": "workspace:*",
    "@showzy/assistant-kit": "workspace:*",
    "@showzy/core": "workspace:*",
    "@showzy/module-kit": "workspace:*",
    "@showzy/validation": "workspace:*",
    "ioredis": "^6.0.0",
    "pino": "^10.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@showzy/db": "workspace:*",
    "@showzy/tooling": "workspace:*",
    "@testcontainers/redis": "^12.1.0",
    "@types/node": "^22.20.1",
    "eslint": "^10.8.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
