{
  "name": "@showzy/validation",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Client-safe shared Zod schemas for action contracts and apps, plus the assistant presentation registry and its parse (ADR-0016, contract.md §2). Domain slices are exported as subpaths; this package owns no actions or tables.",
  "exports": {
    "./assistant-budget": "./src/assistant-budget.ts",
    "./assistant-chat": "./src/assistant-chat.ts",
    "./assistant-surfaces": "./src/assistant-surfaces/index.ts",
    "./catalog": "./src/catalog.ts",
    "./customers": "./src/customers.ts",
    "./entity-ref": "./src/entity-ref.ts",
    "./money": "./src/money.ts",
    "./order-line-catalog-facts": "./src/order-line-catalog-facts.ts",
    "./orders": "./src/orders.ts",
    "./pagination": "./src/pagination.ts",
    "./record-verification": "./src/record-verification.ts",
    "./search": "./src/search/index.ts",
    "./signing": "./src/signing.ts",
    "./slug": "./src/slug.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@showzy/tooling": "workspace:*",
    "@types/node": "^22.20.1",
    "eslint": "^10.8.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
