{
  "name": "@showzy/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Drizzle schema (one file per owning module + foundation), drizzle-kit migrations, Postgres test harness, and seeds. No business logic, no queries.",
  "exports": {
    ".": "./src/index.ts",
    "./schema/*": "./src/schema/*.ts",
    "./seed": "./seed/index.ts",
    "./testing": "./src/testing/harness.ts",
    "./testing/fixtures": "./src/testing/fixtures.ts",
    "./testing/global-setup": "./src/testing/global-setup.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:db": "vitest run --project db",
    "test:unit": "vitest run --project unit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:check-money": "node scripts/check-money-schema.mjs src/schema",
    "db:check-drift": "drizzle-kit generate && node scripts/assert-clean-path.mjs migrations",
    "db:check": "pnpm db:check-money && pnpm db:check-drift",
    "seed:dev-sho": "node --import ./scripts/ts-resolve-register.mjs --env-file=../../.env seed/dev-sho-bakery-cli.ts",
    "backup:verify": "node scripts/backup-verify.mjs"
  },
  "dependencies": {
    "@showzy/config": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@showzy/tooling": "workspace:*",
    "@testcontainers/postgresql": "^12.1.0",
    "@types/node": "^22.20.1",
    "@types/pg": "^8.23.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.8.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
