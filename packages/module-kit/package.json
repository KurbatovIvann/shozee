{
  "name": "@showzy/module-kit",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Server-only micro-utilities shared by domain modules (ADR-0031). This package owns no actions, tables, or client Zod schemas.",
  "exports": {
    "./audit-target": "./src/audit-target.ts",
    "./canonical": "./src/canonical.ts",
    "./key-lock": "./src/key-lock.ts",
    "./optional-nullable-uuid": "./src/optional-nullable-uuid.ts",
    "./parse-db-enum": "./src/parse-db-enum.ts",
    "./postgres-unique": "./src/postgres-unique.ts",
    "./require": "./src/require.ts",
    "./revision": "./src/revision.ts",
    "./sha256": "./src/sha256.ts",
    "./unique-ids": "./src/unique-ids.ts",
    "./writable": "./src/writable.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "@showzy/core": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@showzy/db": "workspace:*"
  },
  "devDependencies": {
    "@showzy/db": "workspace:*",
    "@showzy/tooling": "workspace:*",
    "@types/node": "^22.20.1",
    "eslint": "^10.8.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
