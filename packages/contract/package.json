{
  "name": "@showzy/contract",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The boundary between action definitions and every consumer (contract.md, ADR-0004/0016): the client-safe root derives the oRPC contract router, typed client, wire-error table, money wire helpers, and the AI tool-manifest source from action descriptors; the ./server subpath pairs contract procedures with registered implementations through the core execution pipeline. Owns no logic and no state.",
  "exports": {
    ".": "./src/client/index.ts",
    "./server": "./src/server/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit && tsc -p tsconfig.client.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "bundle:probe": "node scripts/bundle-probe.mjs",
    "openapi:generate": "node scripts/write-openapi.mjs",
    "openapi:check": "pnpm openapi:generate && node ../db/scripts/assert-clean-path.mjs openapi.json"
  },
  "dependencies": {
    "@orpc/client": "^1.14.6",
    "@orpc/contract": "^1.14.6",
    "@orpc/server": "^1.14.6",
    "@showzy/assistant": "workspace:*",
    "@showzy/catalog": "workspace:*",
    "@showzy/chat": "workspace:*",
    "@showzy/companies": "workspace:*",
    "@showzy/core": "workspace:*",
    "@showzy/customers": "workspace:*",
    "@showzy/doc-generation": "workspace:*",
    "@showzy/documents": "workspace:*",
    "@showzy/doc-signing": "workspace:*",
    "@showzy/files": "workspace:*",
    "@showzy/invites": "workspace:*",
    "@showzy/orders": "workspace:*",
    "@showzy/pricing": "workspace:*",
    "@showzy/search": "workspace:*",
    "@showzy/validation": "workspace:*",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@orpc/openapi": "^1.15.0",
    "@orpc/zod": "^1.15.0",
    "@showzy/db": "workspace:*",
    "@showzy/tooling": "workspace:*",
    "@types/node": "^22.20.1",
    "esbuild": "^0.27.7",
    "eslint": "^10.8.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
