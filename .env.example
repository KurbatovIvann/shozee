# Local development environment — copy to .env and adjust if needed.
# Values below match docker-compose.yml. Every variable is validated at boot
# by packages/config (fail-fast); empty values are treated as unset.

NODE_ENV=development

# PostgreSQL (docker compose service `postgres`).
# DATABASE_URL is the runtime-role connection; DATABASE_MIGRATE_URL is used
# only by the migration step. The showzy_app/showzy_migrate roles exist as
# NOLOGIN privilege containers (db.md §6); locally both URLs point at the
# compose superuser — real environments attach LOGIN users per role.
DATABASE_URL=postgresql://showzy:showzy@localhost:5432/showzy
DATABASE_MIGRATE_URL=postgresql://showzy:showzy@localhost:5432/showzy

# Redis (docker compose service `redis`). One instance, shared and
# non-persistent: it holds plaintext OTP codes, so it never writes to disk
# (db.md §6). Durable work is pg-boss in Postgres (ADR-0041).
REDIS_URL=redis://localhost:6379

# S3-compatible object storage (docker compose service `garage`, ADR-0027).
# Production is Cloudflare R2. Path-style is required locally.
S3_ENDPOINT=http://localhost:3900
# Signed PUT/GET host for phones/simulators. Empty = S3_ENDPOINT.
# Device-break shape: empty + S3_ENDPOINT=http://localhost:3900 signs
# client URLs against loopback. The API warns (host class only). Phones
# cannot PUT/GET that host. Set this to http://<LAN-host>:3900 (same host
# as EXPO_PUBLIC_API_URL) and restart the API.
S3_PUBLIC_ENDPOINT=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=showzy-local
S3_SECRET_ACCESS_KEY=showzy-local-secret
S3_FORCE_PATH_STYLE=true
S3_BUCKET=showzy

# better-auth (consumed from fnd-T6). Secret must be >= 32 characters;
# generate a real one per environment — never reuse this dev placeholder.
BETTER_AUTH_SECRET=dev-only-secret-change-me-0000000000
BETTER_AUTH_URL=http://localhost:3000
API_PORT=3000

# Comma-separated browser origins of the web panel (ADR-0030); each joins
# better-auth trustedOrigins. Empty = no web panel origin trusted. Local
# dev: the Vite dev server (http://localhost:5173). Production: the panel
# host serving apps/web behind the same-origin proxy (apps/web/deploy).
WEB_APP_ORIGINS=http://localhost:5173

# HMAC secret for public rate-limit IP keys (core.md §10). Must be >= 32
# characters; generate a real one per environment — never reuse this
# placeholder, and never derive it from other secrets.
IP_HMAC_SECRET=dev-only-ip-hmac-secret-change-me-00

# Comma-separated ingress proxy IPs/CIDRs whose forwarded-IP headers are
# trusted (security-operations §2). Empty = trust no proxy (local dev).
TRUSTED_PROXIES=

# Sentry (optional; empty disables reporting).
SENTRY_DSN=

# OTP delivery. Development/test default to stub (no I/O). Production must
# set resend + sms-fly with live keys and from-line; empty is unset.
# Live HTTP adapters are composed in apps/api (auth-T2). Do not commit keys.
OTP_EMAIL_TRANSPORT=stub
OTP_SMS_TRANSPORT=stub
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_FROM_NAME=
SMS_FLY_API_KEY=
SMS_FLY_API_URL=https://sms-fly.ua/api/v2/api.php
SMS_FLY_SENDER=

# Staff-panel AI (Shozik / packages/ai, ADR-0032). ANTHROPIC_API_KEY is a
# secret — optional in development and test so CI boots without a paid key.
# Empty is unset. Do not commit a live key. The SSE mount fails typed when
# it is unset. AI_MODEL defaults to claude-haiku-4-5. AI_GATE_MODEL is the
# classifier / chitchat model (not a secret); default claude-haiku-4-5.
ANTHROPIC_API_KEY=
AI_MODEL=claude-haiku-4-5
AI_GATE_MODEL=claude-haiku-4-5
# Staff-assistant spend guards on POST /assistant/chat (SHO-505). `0`
# disables that check. Unknown-model ceiling is not a disable switch.
# Runbook: docs/operations/assistant-budget.md
# Mounts the parallel assistant-kit routes (/assistant/kit/*) alongside the live
# assistant. Off by default; set to 1 to exercise the new path by hand on real
# data. The live assistant is unaffected either way.
AI_ASSISTANT_KIT=1
AI_CHAT_TURNS_PER_MINUTE_PER_USER=20
AI_DAILY_BUDGET_USD_PER_COMPANY=5
AI_DAILY_BUDGET_USD_GLOBAL=100
AI_UNKNOWN_MODEL_TURN_USD=0.10

# Шо service (apps/sho, ADR-0051). SHO_URLS is the comma-separated list of
# internal apps/sho base URLs the API picks a replica from by rendezvous hash
# of companyId; empty means no Шо and every staff turn goes to the LLM.
# SHO_SERVICE_TOKEN is a shared bearer secret (>= 32 chars) — set the same
# value on apps/api and apps/sho. It is a secret: do not commit a real one.
# SHO_PORT is the apps/sho listen port; internal only, never ingress.
# SHO_WORKERS is the parse worker_threads pool size; unset means CPU count - 1.
# Each worker holds its own runtime (~140 MB) and a share of the context cache.
# SHO_ACTIONS is the comma-separated list of <module>.<verb> actions Шо may
# plan without the LLM (SHO-769); empty means it plans none of them. An action
# only plans when a planner is registered for it AND its tool composes an
# assistant surface — a read with no surface would settle with a reply and no
# data, so it falls back to the LLM. To try Шо-first reads in dev, paste
# @showzy/assistant-runtime's SHO_SURFACED_READ_ACTIONS (and SHO_WRITE_ACTIONS,
# SHO_ORDER_LIFECYCLE_ACTIONS, SHO_CUSTOMER_WRITE_ACTIONS or
# SHO_DOCUMENT_WRITE_ACTIONS for writes); a planner still waiting for its
# surface is in SHO_READ_ACTIONS and not there.
SHO_URLS=
SHO_SERVICE_TOKEN=
SHO_ACTIONS=
SHO_PORT=3100
SHO_WORKERS=

# Voice capture for the assistant (SHO-744): staff speak into the mic and the
# API streams PCM to Google Speech-to-Text v2 (Chirp 3, uk-UA + ru-RU) over
# WS /assistant/kit/voice. No audio is stored. Unset VOICE_GOOGLE_CREDENTIALS_FILE
# leaves the route unmounted. The file is a Google service-account key: keep it
# out of the repo, and never read or print it anywhere but the Google client.
# VOICE_GOOGLE_PROJECT_ID defaults to the key's own project.
# VOICE_GOOGLE_LOCATION is the Speech-to-Text v2 region serving Chirp 3.
# VOICE_SESSIONS_PER_MINUTE_PER_USER bounds billed Chirp seconds: a token
# bucket on the handshake, per staff user, refilling over a minute. Past it
# the handshake answers 429 and no recognizer opens. 0 disables the check.
VOICE_GOOGLE_CREDENTIALS_FILE=
VOICE_GOOGLE_PROJECT_ID=
VOICE_GOOGLE_LOCATION=eu
VOICE_SESSIONS_PER_MINUTE_PER_USER=6
