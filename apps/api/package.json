{
  "name": "@showzy/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "HTTP transport composition: Hono app, better-auth, session/principal dispatch, oRPC at /rpc and OpenAPI REST at /api/v1 (fnd-T26).",
  "exports": {
    "./subscriptions": "./src/subscriptions.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "contract:check": "vitest run --project unit src/composition.contract-check.test.ts",
    "start": "node --experimental-strip-types --import ../../packages/db/scripts/ts-resolve-register.mjs --env-file=../../.env src/index.ts",
    "auth:generate": "auth generate --config src/auth/cli.ts --output ../../packages/db/src/schema/auth.ts --yes && node scripts/with-timezone.mjs ../../packages/db/src/schema/auth.ts && pnpm -w exec prettier --write packages/db/src/schema/auth.ts",
    "auth:check": "pnpm auth:generate && node ../../packages/db/scripts/assert-clean-path.mjs ../../packages/db/src/schema/auth.ts"
  },
  "dependencies": {
    "@better-auth/expo": "1.6.30",
    "@hono/node-server": "^2.1.1",
    "@orpc/client": "1.15.0",
    "@orpc/openapi": "1.15.0",
    "@orpc/server": "1.15.0",
    "@sentry/node": "^10.70.0",
    "@showzy/ai": "workspace:*",
    "@showzy/assistant": "workspace:*",
    "@showzy/assistant-kit": "workspace:*",
    "@showzy/catalog": "workspace:*",
    "@showzy/chat": "workspace:*",
    "@showzy/companies": "workspace:*",
    "@showzy/config": "workspace:*",
    "@showzy/customers": "workspace:*",
    "@showzy/documents": "workspace:*",
    "@showzy/document-signing": "workspace:*",
    "@showzy/doc-generation": "workspace:*",
    "@showzy/doc-signing": "workspace:*",
    "@showzy/files": "workspace:*",
    "@showzy/invites": "workspace:*",
    "@showzy/contract": "workspace:*",
    "@showzy/core": "workspace:*",
    "@showzy/db": "workspace:*",
    "@showzy/orders": "workspace:*",
    "@showzy/pricing": "workspace:*",
    "@showzy/search": "workspace:*",
    "@showzy/validation": "workspace:*",
    "better-auth": "^1.6.30",
    "hono": "^4.13.3",
    "ioredis": "^6.0.0",
    "pino": "^10.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@showzy/tooling": "workspace:*",
    "@testcontainers/redis": "^12.1.0",
    "@types/node": "^22.20.1",
    "auth": "^1.6.30",
    "eslint": "^10.8.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
