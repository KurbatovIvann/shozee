{
  "name": "@showzy/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Outbox poller, delivery executor, and BullMQ maintenance job host (fnd-T27 / fnd-T29 / SHO-120).",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "start": "node --experimental-strip-types --import ../../packages/db/scripts/ts-resolve-register.mjs --env-file=../../.env src/index.ts"
  },
  "dependencies": {
    "@sentry/node": "^10.70.0",
    "@showzy/api": "workspace:*",
    "@showzy/assistant-runtime": "workspace:*",
    "@showzy/chat": "workspace:*",
    "@showzy/config": "workspace:*",
    "@showzy/core": "workspace:*",
    "@showzy/db": "workspace:*",
    "@showzy/doc-generation": "workspace:*",
    "@showzy/doc-signing": "workspace:*",
    "@showzy/documents": "workspace:*",
    "@showzy/files": "workspace:*",
    "bullmq": "6.2.0",
    "ioredis": "^6.0.0",
    "pg": "^8.23.0",
    "pino": "^10.3.1"
  },
  "devDependencies": {
    "@showzy/tooling": "workspace:*",
    "@testcontainers/redis": "^12.1.0",
    "@types/node": "^22.20.1",
    "@types/pg": "^8.23.0",
    "drizzle-orm": "^0.45.2",
    "eslint": "^10.8.1",
    "testcontainers": "12.1.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10",
    "zod": "^4.4.3"
  }
}
